# shortcut to this dotfiles path is $ZSH
export ZSH=$HOME/.dotfiles

# Stash your environment variables in ~/.localrc. This means they'll stay out
# of your main dotfiles repository (which may be public, like this one), but
# you'll have access to them in your scripts.
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

# JAVA（必须在加载 dotfiles 之前设置，否则会被 react-native/java.zsh 覆盖为 Java 17）
export MAVEN_OPTS="-Xms256m -Xmx1024m -Dfile.encoding=UTF-8"
export JAVA_HOME="/Library/Java/JavaVirtualMachines/jdk-1.8.jdk/Contents/Home"
export PATH="$JAVA_HOME/bin:$PATH"

# Load Zinit
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
[ ! -d $ZINIT_HOME ] && mkdir -p "$(dirname $ZINIT_HOME)"
[ ! -d $ZINIT_HOME/.git ] && git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
source "${ZINIT_HOME}/zinit.zsh"

# Load Zinit plugin configurations
if [[ -f "$ZSH/zsh/zinit.zsh" ]]; then
  source "$ZSH/zsh/zinit.zsh"
fi

# all of our zsh files
typeset -U config_files
config_files=($ZSH/**/*.zsh)

# load the path files
for file in ${(M)config_files:#*/path.zsh}
do
  source $file
done

# load everything but the path, completion, and zinit files
for file in ${${${config_files:#*/path.zsh}:#*/completion.zsh}:#*/zinit.zsh}
do
  source $file
done

# initialize autocomplete here, otherwise functions won't be loaded
autoload -U compinit
compinit

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}
do
  source $file
done

# worktree
wt-add() {
  local branch="$1"
  if [ -z "$branch" ]; then
    echo "用法: wt-add <branch-name>"
    return 1
  fi
  local repo_name=$(basename "$(git rev-parse --show-toplevel)")
  local parent_dir=$(dirname "$(git rev-parse --show-toplevel)")
  local wt_dir="${parent_dir}/${repo_name}--${branch}"

  if git show-ref --verify --quiet "refs/heads/${branch}" 2>/dev/null; then
    git worktree add "$wt_dir" "$branch"
  else
    git worktree add -b "$branch" "$wt_dir"
  fi

  echo "Worktree 已创建: $wt_dir"
  echo "执行: cd $wt_dir && pnpm install"
}

wt-list() {
  git worktree list
}

wt-remove() {
  local branch="$1"
  if [ -z "$branch" ]; then
    echo "用法: wt-remove <branch-name>"
    return 1
  fi
  local repo_name=$(basename "$(git rev-parse --show-toplevel)")
  local parent_dir=$(dirname "$(git rev-parse --show-toplevel)")
  local wt_dir="${parent_dir}/${repo_name}--${branch}"

  git worktree remove "$wt_dir"
  echo "Worktree 已移除: $wt_dir"
}

wt-cd() {
  local branch="$1"
  if [ -z "$branch" ]; then
    echo "用法: wt-cd <branch-name>"
    return 1
  fi
  local repo_name=$(basename "$(git rev-parse --show-toplevel)")
  local parent_dir=$(dirname "$(git rev-parse --show-toplevel)")
  local wt_dir="${parent_dir}/${repo_name}--${branch}"

  if [ -d "$wt_dir" ]; then
    cd "$wt_dir"
  else
    echo "Worktree 不存在: $wt_dir"
  fi
}

unset config_files

# zoxide must be initialized at the end of shell config
if command -v zoxide &> /dev/null; then
  eval "$(zoxide init zsh)"
fi
